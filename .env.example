# Copy this file to .env.local and fill it in. .env.local is gitignored.
#
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser. Everything else is
# server-only and read through serverEnv() in src/lib/env.ts.

# --- Supabase -----------------------------------------------------------------
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Same URL again, for the server. Kept separate so the server never depends on
# a NEXT_PUBLIC_ value that a future refactor might change.
SUPABASE_URL=https://yourproject.supabase.co

# Bypasses row-level security. Only the Apify webhook uses it. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Apify --------------------------------------------------------------------
# console.apify.com → Settings → Integrations → API token
APIFY_TOKEN=

# The actor that scrapes YouTube channels.
APIFY_YOUTUBE_ACTOR=streamers/youtube-scraper

# The actor that scrapes Instagram profiles. About $0.0027 per post — four to
# six times YouTube's rate, which is why a scrape reads 40 posts and not 100.
APIFY_INSTAGRAM_ACTOR=apify/instagram-scraper

# The actor that pulls a single video's captions. About $0.50 per 1,000
# transcripts, which is a rounding error next to the AI summary that follows it.
# Leave BLANK to switch the transcript feature off entirely — the page then says
# so plainly instead of failing when someone presses the button.
APIFY_TRANSCRIPT_ACTOR=supreme_coder/youtube-transcript-scraper

# Shared secret proving a webhook really came from your Apify run.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APIFY_WEBHOOK_SECRET=

# --- Firecrawl ----------------------------------------------------------------
FIRECRAWL_API_KEY=

# --- OpenAI -------------------------------------------------------------------
# platform.openai.com — used for idea generation. The key is shown once, so if
# you lose it you create a new one rather than recovering the old.
OPENAI_API_KEY=

# Change this if you want a different model. Kept in env so swapping models
# never needs a code change or a deploy.
OPENAI_MODEL=gpt-4o

# --- App ----------------------------------------------------------------------
# Where Apify sends webhooks back to. Must be publicly reachable — for local
# development use a tunnel (ngrok, cloudflared), not localhost.
APP_URL=http://localhost:3111

# --- Razorpay -----------------------------------------------------------------
# Payments and autopay. In the Razorpay dashboard this is NOT under "Settings" —
# it is Account & Settings → API Keys, in the "Website and app settings" group.
# Pick Test or Live in the top ribbon BEFORE generating: keys are per-mode, and
# so are plans, offers and webhook secrets.
#
# LIVE keys move real money the moment someone clicks Go Pro. Test keys
# (rzp_test_…) behave identically with fake cards — use those while trying it.
#
# The key id is publishable and is needed by the browser to open checkout, so it
# appears twice: once for the server, once with the NEXT_PUBLIC_ prefix. The
# SECRET must never gain that prefix.
RAZORPAY_KEY_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# The subscription plans Pro bills against. Create both at once with:
#   npm run razorpay:plan
# It prints the ids to paste here. A Razorpay plan hard-codes its period AND
# its amount, which is why monthly and yearly are two separate objects.
#
# Leaving the yearly one blank is fine: the monthly/yearly toggle simply does
# not appear, and everything else keeps working.
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_PRO_YEARLY=

# Razorpay Dashboard → Settings → Webhooks. Set the URL to
# <APP_URL>/api/webhooks/razorpay, subscribe to every subscription.* event PLUS
# order.paid (that one grants refill packs), and paste the secret you chose here.
# Razorpay cannot reach localhost, so local development relies on the polling
# fallbacks at /api/billing/sync and /api/billing/topup/confirm instead.
RAZORPAY_WEBHOOK_SECRET=

# PayPal fallback for international customers, while Razorpay's International
# Payments approval is pending.
#
# NOT a second checkout. Razorpay Subscriptions accepts cards, UPI Autopay and
# eMandate only — a PayPal wallet cannot hold a recurring mandate, so PayPal
# can never be the subscription path. This is a MANUAL bridge: the customer
# pays, the tier is granted by hand, nothing auto-renews.
#
# Leave EMPTY and every trace of it disappears from the UI, which is what
# should happen the day International Payments is approved.
#
# Both link shapes work: https://paypal.me/yourname or a hosted PayPal URL.
NEXT_PUBLIC_PAYPAL_LINK=

# --- PayPal: international subscriptions ------------------------------------
# Razorpay covers India; PayPal covers everyone else. The split is forced:
# Razorpay Subscriptions cannot do PayPal autopay (a wallet holds no mandate),
# and PayPal India business accounts are export-only and cannot take domestic
# INR at all. See docs/paypal-setup.md for the full walkthrough.
#
# From developer.paypal.com -> Apps & Credentials. Sandbox and Live are
# SEPARATE: credentials, plan ids and the webhook id all differ between them.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# "sandbox" or "live". A production build REFUSES to start on sandbox.
PAYPAL_ENV=sandbox

# From the webhook you create at developer.paypal.com. Without it no webhook
# can be verified, so renewals stop being recorded.
PAYPAL_WEBHOOK_ID=

# Created by: npm run paypal:plan
# Only the three MONTHLY ids are required; blank yearly ids hide that toggle.
# AGENCY is the tier displayed as "Max" — the internal key never changed.
PAYPAL_PLAN_ID_CREATOR_MONTHLY=
PAYPAL_PLAN_ID_CREATOR_YEARLY=
PAYPAL_PLAN_ID_STUDIO_MONTHLY=
PAYPAL_PLAN_ID_STUDIO_YEARLY=
PAYPAL_PLAN_ID_AGENCY_MONTHLY=
PAYPAL_PLAN_ID_AGENCY_YEARLY=
